---
layout: null
---
[
  {% assign all_items = "" | split: "," %}
  {% assign all_items = all_items | concat: site.vehicles %}
  {% assign all_items = all_items | concat: site.blogs %}
  {% assign all_items = all_items | concat: site.news %}
  {% assign all_items = all_items | concat: site.products %}
  {% for item in all_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "category": {{ item.category | jsonify }},
    "section": {{ item.section | default: item.collection | jsonify }},
    "excerpt": {{ item.excerpt | default: item.description | strip_html | truncate: 120 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
