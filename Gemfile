source "https://rubygems.org"

# This tells GitHub Pages which Jekyll version + plugin set to build with.
# You do NOT need Ruby installed locally to use GitHub Pages — GitHub
# builds the site for you automatically whenever you push. This Gemfile
# only matters if you ever want to preview the site on your own computer.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
end

gem "webrick", "~> 1.8"
